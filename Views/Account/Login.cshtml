@model tp05.Models.Usuario

@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h2>Iniciar sesión</h2>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success">@ViewBag.Message</div>
        }

        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
        <form id="loginForm" action="/Account/Login" method="post" novalidate>
            <div class="mb-3">
                @Html.LabelFor(m => m.Username, new { @class = "form-label" })
                <input id="Username" name="Username" value="@Model.Username" class="form-control" />
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                <input id="Password" name="Password" type="password" class="form-control" />
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div id="loginError" class="text-danger mb-3"></div>

            <button type="submit" class="btn btn-primary">Ingresar</button>
            <a href="/Account/Register" class="btn btn-link">Registrarme</a>
        </form>
    </div>
</div>
