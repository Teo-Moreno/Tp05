@model tp05.Models.RegisterViewModel

@{
    ViewData["Title"] = "Registro";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2>Registro de usuario</h2>
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
        <form id="registerForm" action="/Account/Register" method="post" novalidate>
            <div class="mb-3">
                @Html.LabelFor(m => m.Username, new { @class = "form-label" })
                <input id="Username" name="Username" value="@Model.Username" class="form-control" />
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                <input id="Password" name="Password" type="password" class="form-control" />
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
                <input id="Nombre" name="Nombre" value="@Model.Nombre" class="form-control" />
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Apellido, new { @class = "form-label" })
                <input id="Apellido" name="Apellido" value="@Model.Apellido" class="form-control" />
                @Html.ValidationMessageFor(m => m.Apellido, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.TipoUsuario, new { @class = "form-label" })
                <select id="TipoUsuario" name="TipoUsuario" class="form-select">
                    <option value="">Seleccione un tipo</option>
                    <option value="Alumno" @(Model.TipoUsuario == "Alumno" ? "selected" : "")>Alumno</option>
                    <option value="Docente" @(Model.TipoUsuario == "Docente" ? "selected" : "")>Docente</option>
                    <option value="Coordinador" @(Model.TipoUsuario == "Coordinador" ? "selected" : "")>Coordinador</option>
                    <option value="Padre" @(Model.TipoUsuario == "Padre" ? "selected" : "")>Padre</option>
                </select>
                @Html.ValidationMessageFor(m => m.TipoUsuario, "", new { @class = "text-danger" })
            </div>

            <div id="registerError" class="text-danger mb-3"></div>
            <button type="submit" class="btn btn-primary">Registrarse</button>
            <a href="/Account/Login" class="btn btn-link">Ya tengo cuenta</a>
        </form>
    </div>
</div>
